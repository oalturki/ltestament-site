[{"sura":102,"aya":1,"translation":"1. La ruée vers les richesses vous distrait,","footnotes":null},{"sura":102,"aya":2,"translation":"2. jusqu’au bord de vos tombes.","footnotes":null},{"sura":102,"aya":3,"translation":"3. Mais vous allez bientôt savoir.","footnotes":null},{"sura":102,"aya":4,"translation":"4. Oui, vous allez bientôt savoir.","footnotes":null},{"sura":102,"aya":5,"translation":"5. Si seulement vous pouviez savoir avec certitude,","footnotes":null},{"sura":102,"aya":6,"translation":"6. Vous verriez alors l’Enfer !","footnotes":null},{"sura":102,"aya":7,"translation":"7. Puis vous le verriez, de vos yeux le verriez,","footnotes":null},{"sura":102,"aya":8,"translation":"8. Puis, ce jour-là, vous serez certes interrogés au sujet des plaisirs.","footnotes":null}]